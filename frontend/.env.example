# ORCA frontend configuration. Copy to `.env.local` for local development; set the same names
# as Environment Variables in the Vercel project settings for a deployment.
#
# Every one of these is optional, and the application states in the UI what it is doing when
# one is absent — nothing here silently changes behaviour.

# Where the Node bridge (and so the C++ engine) is listening. Defaults to http://localhost:4000.
# A deployment with no bridge should leave this unset and set VITE_DEMO_MODE=1 instead.
VITE_BACKEND_URL=http://localhost:4000

# "1" skips probing for the bridge entirely and goes straight to the in-browser kinematic
# model. Set this on a static deployment: without it every visitor makes ~6 requests to a host
# that is not there before the workspace falls back on its own.
VITE_DEMO_MODE=

# Google OAuth 2.0 Web client ID, from console.cloud.google.com -> APIs & Services ->
# Credentials -> Create credentials -> OAuth client ID -> Web application.
#
# Add BOTH of these to "Authorised JavaScript origins" for the client:
#   http://localhost:5173          (local development)
#   https://<your-project>.vercel.app   (the deployment)
#
# With this set, "Continue with Google" opens Google's own account chooser and signs in with no
# password, exactly as on any other site. Without it the button falls back to a device-local
# chooser which says, in the dialog itself, that Google verified nothing.
#
# On Vercel, prefer GOOGLE_CLIENT_ID (no VITE_ prefix) in the project's environment variables:
# the account service in api/ serves it at runtime and verifies Google's tokens against it, so
# no frontend rebuild is needed. This build-time name is for running the frontend on its own.
VITE_GOOGLE_CLIENT_ID=
